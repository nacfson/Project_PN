{
  "name": "project-pn-monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "browser-extension",
    "packages/*"
  ],
  "scripts": {
    "lint:imports": "node scripts/lint-imports.mjs",
    "lint:rntl-async": "node scripts/lint-rntl-async.mjs",
