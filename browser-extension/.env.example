# Base URL of the Project PN API for the extension to call.
EXT_API_BASE_URL=http://localhost:8080

# Base64-encoded RSA public key used to keep the unpacked dev extension ID stable.
# Generate a key pair with:
#   openssl genrsa -out /tmp/pn-dev-key.pem 2048
#   openssl rsa -in /tmp/pn-dev-key.pem -pubout -out /tmp/pn-dev-pub.pem
#   grep -v '^---' /tmp/pn-dev-pub.pem | tr -d '\n'
# PN_DEV_EXTENSION_KEY=YOUR_BASE64_PUBLIC_KEY_HERE
