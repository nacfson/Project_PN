#!/usr/bin/env bash
# Fast pre-commit lint gates (<0.5s): module resolution, RNTL v14 async await, and i18n CSV sync checks.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1

run() { # label command...
  local label="$1"
  shift
  echo "pre-commit: ${label}"
  if ! "$@"; then
    echo "pre-commit: FAILED: ${label}" >&2
    echo "pre-commit: commit blocked. Fix the failure above and commit again." >&2
    exit 1
  fi
}

run "lint:imports" npm run --silent lint:imports
run "lint:rntl-async" npm run --silent lint:rntl-async
run "i18n:check" node scripts/i18n-csv.mjs check

echo "pre-commit: all checks passed"
