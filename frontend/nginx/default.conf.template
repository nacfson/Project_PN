server {
    listen 80;
    server_name _;

    root /usr/share/nginx/web;
    index index.html;

    location = /healthz {
        proxy_pass http://${PN_BACKEND_HOST}:${PN_BACKEND_PORT};
    }

    location = /readyz {
        proxy_pass http://${PN_BACKEND_HOST}:${PN_BACKEND_PORT};
    }

    location /api/ {
        proxy_pass http://${PN_BACKEND_HOST}:${PN_BACKEND_PORT};
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
