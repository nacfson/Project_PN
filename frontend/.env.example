# Backend API base URL (no trailing slash).
# Web / Tauri desktop (local): http://localhost:8080
# Android emulator: http://10.0.2.2:8080
# Physical device against production: https://pn.nacfson.cloud
#   (do NOT use http://localhost:8080 on a real phone — that is the phone itself)
# Hosted web exports can omit this when the same public origin reverse-proxies
# the API; native Release / Xcode embeds must set it (see ios/.xcode.env).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Opt-in behavioral analytics delivery. Disabled for local development and tests.
EXPO_PUBLIC_ANALYTICS_ENABLED=false

# Comma-separated fallback API URLs — LOCAL DEV ONLY (__DEV__). Ignored in
# production/release builds. Prefer a single EXPO_PUBLIC_API_BASE_URL for
# release; use LAN split DNS so pn.nacfson.cloud resolves on intranet
# (see deploy/NETWORK_SETUP.md) instead of baking private IPs into the app.
# EXPO_PUBLIC_API_FALLBACK_URLS=http://192.168.219.120:8080

# Authentication is handled by platform Keycloak and Traefik ForwardAuth.
# In local development, authenticate via ?token=mock-dev-token when AUTH_DEV_BYPASS=true.

# Xcode Release: env is also set in frontend/ios/.xcode.env (NODE_ENV=production +
# EXPO_PUBLIC_API_BASE_URL). Do not leave EXPO_PUBLIC_API_BASE_URL= empty in
# .env.production.local — that clears the production URL.

# Tauri CSP (src-tauri/tauri.conf.json connect-src): includes http:/https: for staging.
# If you lock CSP down, add your EXPO_PUBLIC_API_BASE_URL origin explicitly.

# Chrome extension ID used to send the login token back to the browser extension.
# Set this to the stable ID shown in chrome://extensions for the unpacked dev build.
# EXPO_PUBLIC_PN_EXTENSION_ID=your_dev_extension_id_here
