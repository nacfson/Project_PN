FROM nginx:1.27-alpine

ARG SERVICE_VERSION=v0.0.0
ARG VCS_REF=""
ENV SERVICE_VERSION=${SERVICE_VERSION}

# Link this image to the GitHub repo so Actions GITHUB_TOKEN can publish to GHCR.
LABEL org.opencontainers.image.source="https://github.com/nacfson/Project_PN"
LABEL org.opencontainers.image.description="Project PN frontend (Expo web / nginx)"
LABEL org.opencontainers.image.version="${SERVICE_VERSION}"
LABEL org.opencontainers.image.revision="${VCS_REF}"

COPY dist /usr/share/nginx/web
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY nginx/docker-entrypoint.sh /docker-entrypoint-pn.sh

RUN chmod +x /docker-entrypoint-pn.sh \
    && sed -i "s|SERVICE_VERSION=v0.0.0|SERVICE_VERSION=${SERVICE_VERSION}|g" /docker-entrypoint-pn.sh \
    && rm -f /etc/nginx/conf.d/default.conf

ENTRYPOINT ["/docker-entrypoint-pn.sh"]
CMD ["nginx", "-g", "daemon off;"]
