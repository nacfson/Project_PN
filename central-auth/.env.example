APP_ADDR=:8090
DATABASE_URL=postgres://project_pn:project_pn_dev_password@localhost:5433/central_auth_dev?sslmode=disable
MIGRATIONS_PATH=file://db/migrations
AUTH_SESSION_INTERNAL_TOKEN=dev-internal-token
COOKIE_DOMAIN=localhost
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=2160h
SESSION_IDLE_TIMEOUT=168h
SESSION_MAX_AGE=720h
MAGIC_LINK_TTL=15m
DEV_LOG_MAGIC_LINKS=true

# Public URL for magic links and OAuth redirects
PUBLIC_BASE_URL=http://localhost:8090

# Google OAuth (optional in local dev; required in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8090/auth/google/callback

# Comma-separated admin emails
ADMIN_EMAILS=nacfson@gmail.com

# Magic-link email delivery (optional; falls back to DEV_LOG_MAGIC_LINKS when unset)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=auth@nacfson.cloud
