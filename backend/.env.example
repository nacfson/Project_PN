APP_ADDR=:8080
DATABASE_URL=postgres://project_pn:project_pn_dev_password@localhost:5433/project_pn_dev?sslmode=disable
MIGRATIONS_PATH=file://db/migrations

# Local PostgreSQL credentials used by backend/compose.yaml.
# These must match DATABASE_URL above.
POSTGRES_USER=project_pn
POSTGRES_PASSWORD=project_pn_dev_password
POSTGRES_DB=project_pn_dev

# Gloss origin (default: free public WiktApi — Wiktionary/Kaikki). NO API key.
ORIGIN_WIKTAPI_BASE_URL=https://api.wiktapi.dev
# Optional legacy Gemini/OpenAI fallback when WiktApi misses a word:
#   ENRICH_PRIMARY_API_KEY=... (Cursor secrets / local only; gitignored)
ENRICH_PRIMARY_BASE_URL=
ENRICH_PRIMARY_API_KEY=
ENRICH_PRIMARY_MODEL=
ENRICH_FALLBACK_BASE_URL=
ENRICH_FALLBACK_API_KEY=
ENRICH_FALLBACK_MODEL=

# Single seeded dev user (no auth in MVP). Must match migration 000002.
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
DEFAULT_TARGET_LANG=en
DEFAULT_DEFINITION_LANG=ko

# Optional language restriction/override for new registrations.
# ALLOWED_* are comma-separated ISO 639-1 codes; empty means unrestricted.
# FORCE_* override user selection entirely and hide the selector in the UI.
ALLOWED_TARGET_LANGS=
ALLOWED_DEFINITION_LANGS=
FORCE_TARGET_LANG=
FORCE_DEFINITION_LANG=

# App UI language defaults and restrictions (ISO 639-1 codes).
DEFAULT_UI_LANGUAGE=en
ALLOWED_UI_LANGUAGES=
FORCE_UI_LANGUAGE=

# CORS origins allowed to call the API (comma-separated).
# Covers Expo web dev (:8081 / :19006) and Tauri desktop WebView origins.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,tauri://localhost,http://tauri.localhost

# Chrome extension IDs allowed to call the API directly.
# Set these to the stable IDs shown in chrome://extensions.
PN_DEV_EXTENSION_ID=
PN_PROD_EXTENSION_ID=

# Auth (Platform Keycloak Gateway JWT - Feature 001-gateway-jwt-auth)
AUTH_JWT_ISSUER=https://auth.nacfson.cloud/realms/platform
AUTH_JWT_AUDIENCE=project-pn
AUTH_JWT_JWKS_URL=http://keycloak-service.identity.svc:8080/realms/platform/protocol/openid-connect/certs
AUTH_JWT_ALLOWED_ALGS=RS256
AUTH_JWT_CLOCK_SKEW=1m
# Set to true only in local/non-prod environments to allow Bearer mock-dev-token
AUTH_DEV_BYPASS=false

# Legacy Central Auth (Deprecated - to be removed post-cutover)
# CENTRAL_AUTH_URL=https://auth.nacfson.cloud
# CENTRAL_AUTH_INTERNAL_URL=
# AUTH_SESSION_INTERNAL_TOKEN=
PUBLIC_APP_URL=http://localhost:8081

# Admin audit log file path. Empty value disables admin logging.
ADMIN_LOG_PATH=/var/log/project-pn/admin.log

# Daily learning analytics log directory (UTC YYYYMMDD_log files). Empty disables.
LEARNING_LOG_DIR=

# Structured behavioral analytics. Disabled locally by default; production
# Vector collects stdout records with kind="analytics" when explicitly enabled.
ANALYTICS_ENABLED=false

# AWS S3 database dump/restore (scripts/db-dump-to-s3.sh, scripts/db-restore-from-s3.sh).
# Names only. Values stay in this gitignored file, an AWS CLI profile, or Cursor secrets.
# Do not put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here.
# See backend/docs/db-s3-migration.md.
S3_BACKUP_BUCKET=
S3_BACKUP_PREFIX=postgres
S3_BACKUP_ENV=local
AWS_REGION=
AWS_PROFILE=
S3_SSE=AES256
S3_KMS_KEY_ID=
S3_ENDPOINT_URL=
AGE_RECIPIENT=
AGE_IDENTITY_FILE=
