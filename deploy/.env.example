# Production deploy defaults. Copy to .env on the remote server and adjust.
#
# Compose reads this file via: docker compose --env-file .env up -d
# Keep permissions tight: chmod 600 .env

BACKEND_IMAGE=ghcr.io/nacfson/project-pn-backend:latest

POSTGRES_PASSWORD=change_me_to_a_strong_password
DATABASE_URL=postgres://project_pn:change_me_to_a_strong_password@postgres:5432/project_pn?sslmode=disable

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=https://YOUR_PUBLIC_DOMAIN,http://localhost:8081
APP_PUBLIC_URL=https://YOUR_PUBLIC_DOMAIN
# Leave empty to default to APP_PUBLIC_URL.
WEB_APP_PUBLIC_URL=

# Central auth (Brain).
CENTRAL_AUTH_URL=https://auth.nacfson.cloud

# Word enrichment — Gemini only.
# Base URL is hardcoded in the backend; set key + cheapest Flash-Lite model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

DEFAULT_TARGET_LANG=en
DEFAULT_DEFINITION_LANG=ko
