# Production deploy defaults. Copy to deploy/.env on wlUbuntu and adjust.
# Production HTTPS for pn.nacfson.cloud / auth.nacfson.cloud terminates on
# ingress-nginx with Let's Encrypt (acme.sh ALPN). Compose keeps ./certs/ in
# sync via the acme reload hook. Forward router 80/443 to 192.168.219.120.
#
# The frontend web bundle is built locally by scripts/deploy-remote.sh and
# uploaded to ./web/ on the server. Compose nginx serves it on :53412; ingress
# proxies https://pn.nacfson.cloud → that port. /api/, /healthz, /readyz, and
# /auth/callback are proxied to the backend.

BACKEND_IMAGE=project-pn-backend:latest

POSTGRES_PASSWORD=change_me_to_a_strong_password
DATABASE_URL=postgres://project_pn:change_me_to_a_strong_password@postgres:5432/project_pn?sslmode=disable

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=https://pn.nacfson.cloud,http://192.168.219.120:53412,http://localhost:8081,tauri://localhost,http://tauri.localhost

# Auth. Use local for standalone Project PN, central to trust Brain auth.
AUTH_MODE=central
CENTRAL_AUTH_URL=https://auth.nacfson.cloud
# Required for Compose: HTTP NodePort to auth-service (avoids self-signed TLS to ingress).
# CENTRAL_AUTH_INTERNAL_URL=http://192.168.219.120:31956

# Word enrichment (OpenAI-compatible). Leave both BASE_URLs empty for cache-only lookups.
# Primary provider (tried first):
ENRICH_PRIMARY_BASE_URL=
ENRICH_PRIMARY_API_KEY=
ENRICH_PRIMARY_MODEL=
# Fallback provider (tried when primary fails):
ENRICH_FALLBACK_BASE_URL=
ENRICH_FALLBACK_API_KEY=
ENRICH_FALLBACK_MODEL=

DEFAULT_TARGET_LANG=en
DEFAULT_DEFINITION_LANG=ko

# Optional language restriction/override for new registrations.
# ALLOWED_* are comma-separated ISO 639-1 codes; empty means unrestricted.
# FORCE_* override user selection entirely and hide the selector in the UI.
ALLOWED_TARGET_LANGS=
ALLOWED_DEFINITION_LANGS=
FORCE_TARGET_LANG=
FORCE_DEFINITION_LANG=

# Email. Public local-auth deploy should use real email and verified accounts.
EMAIL_PROVIDER=resend
SESSION_TTL=720h
EMAIL_VERIFICATION_TTL=24h
APP_PUBLIC_URL=https://pn.nacfson.cloud
# For reverse-proxy deploys, the web app usually shares the API origin.
# Leave empty to default to APP_PUBLIC_URL.
WEB_APP_PUBLIC_URL=

# Admin audit log inside the api container (persisted via compose volume).
# Empty disables the file logger (admin.NoopLogger).
ADMIN_LOG_PATH=/var/log/project-pn/admin.log

# Resend (when EMAIL_PROVIDER=resend)
RESEND_API_KEY=
EMAIL_FROM=auth@example.com
