[Unit]
Description=Periodically pull and redeploy Project PN from the registry (GHCR)

[Timer]
# First check shortly after boot, then every few minutes.
OnBootSec=2min
OnUnitActiveSec=3min
# Run a missed check immediately if the machine was off at the scheduled time.
Persistent=true
Unit=project-pn-update.service

[Install]
WantedBy=timers.target
