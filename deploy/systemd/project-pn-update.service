[Unit]
Description=Update Project PN stack from the registry (GHCR)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
# Adjust User and paths for your instance. Amazon Linux default user is ec2-user;
# on Ubuntu use ubuntu and /home/ubuntu.
User=ec2-user
Environment=DEPLOY_DIR=/home/ec2-user/project-pn/deploy
ExecStart=/home/ec2-user/project-pn/deploy/self-update.sh
