<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>cloud.cursor.project-pn.worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPO_ROOT/scripts/start-cursor-worker.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>REPO_ROOT</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/cursor-project-pn-worker.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/cursor-project-pn-worker.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CURSOR_WORKER_NAME</key>
    <string>project-pn-mac</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin:/Users/hyungjuyu/.local/bin</string>
  </dict>
</dict>
</plist>
